{
  "lsp": {
    "basedpyright": {
      "settings": {
        "python": {
          "pythonPath": "server/.venv/bin/python",
        },
        "basedpyright": {
          "analysis": {
            // This disables all type checking while keeping "Go to Definition"
            "typeCheckingMode": "off",
          },
        },
      },
    },
  },
  "languages": {
    "Python": {
      "code_actions_on_format": {
        "source.organizeImports.ruff": true,
      },
      "formatter": {
        "language_server": {
          "name": "ruff",
        },
      },
      "language_servers": ["!basedpyright", "ruff", "pyright"],
    },
  },
}
